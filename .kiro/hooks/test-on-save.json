{
  "version": "v1",
  "hooks": [
    {
      "name": "test-on-save",
      "trigger": "PostFileSave",
      "matcher": "(src/.*\\.ts|test/.*\\.ts|spike/.*\\.ts)$",
      "action": {
        "type": "command",
        "command": "npx vitest related --run --reporter=dot"
      }
    },
    {
      "name": "openapi-drift-on-route-change",
      "trigger": "PostFileSave",
      "matcher": "src/http/.*\\.ts$",
      "action": {
        "type": "command",
        "command": "npm run openapi:check"
      }
    }
  ]
}
